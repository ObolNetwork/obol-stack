# Example environment configuration for Obol Stack Frontend
# Copy this file to .env.local and adjust the values for your environment

# === For deployment inside Kubernetes cluster ===
# Service URLs using Kubernetes internal DNS
PROMETHEUS_URL=http://monitoring-kube-prometheus-prometheus.monitoring.svc.cluster.local:9090
ERPC_URL=http://rpc.l1.svc.cluster.local
GRAFANA_URL=http://monitoring-grafana.monitoring.svc.cluster.local
BEACON_API_URL=http://l1-full-node-beacon.l1.svc.cluster.local:5052
EXECUTION_RPC_URL=http://l1-full-node-execution.l1.svc.cluster.local:8545
# WalletConnect Project ID for RainbowKit
# NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# === For local development (outside cluster) ===
# Uncomment these when running locally with port-forwarding
# PROMETHEUS_URL=http://localhost:9090
# ERPC_URL=http://obol.stack
# GRAFANA_URL=http://obol.stack/monitoring
# BEACON_API_URL=http://localhost:5052
# EXECUTION_RPC_URL=http://localhost:8545

# Network Configuration
DEFAULT_NETWORK=hoodi
MAINNET_CHAIN_ID=1
HOODI_CHAIN_ID=560048

# Update Intervals (in milliseconds)
BLOCK_UPDATE_INTERVAL=12000
METRICS_UPDATE_INTERVAL=5000
SYSTEM_UPDATE_INTERVAL=10000

# Feature Flags
ENABLE_REAL_METRICS=true
ENABLE_WEBSOCKET=false
ENABLE_AZTEC_MOCK=true

# ADK Agent Configuration
ADK_AGENT_URL=http://localhost:8000