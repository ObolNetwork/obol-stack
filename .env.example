# Example environment configuration for Obol Stack Frontend
# Copy this file to .env.local and adjust the values for your environment

# === For deployment inside Kubernetes cluster ===
# Service URLs using Kubernetes internal DNS
NEXT_PUBLIC_PROMETHEUS_URL=http://monitoring-kube-prometheus-prometheus.monitoring.svc.cluster.local:9090
NEXT_PUBLIC_ERPC_URL=https://obol.stack/rpc

# WalletConnect Project ID for RainbowKit
# Get your project ID from https://cloud.walletconnect.com
# NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# === For local development (outside cluster) ===
# Uncomment these when running locally with port-forwarding
# NEXT_PUBLIC_PROMETHEUS_URL=http://localhost:9090
# NEXT_PUBLIC_ERPC_URL=http://obol.stack

# Kubernetes configuration for local development
# NEXT_PUBLIC_KUBECONFIG=/path/to/your/kubeconfig

# Service catalog for Obol Services / marketplace (server-side only).
# Auto-defaults to http://obol.stack:8080/api/services.json outside the cluster.
# MARKETPLACE_CATALOG_URL=http://obol.stack:8080/api/services.json

# Prometheus for dashboard node overview (local dev needs port-forward):
# kubectl port-forward -n monitoring svc/monitoring-kube-prometheus-prometheus 9090:9090
# NEXT_PUBLIC_PROMETHEUS_URL=http://localhost:9090

# ADK Agent Configuration (server-side only, no NEXT_PUBLIC_ prefix)
# NEXT_PUBLIC_ADK_AGENT_URL=http://localhost:8000

# Feature Flags
# NEXT_PUBLIC_FEATURE_TAG_VERSION_SHA_COMMIT=false

# Base Sepolia OBOL test faucet (server runtime config for x402 OBOL smoke tests)
# BASE_SEPOLIA_OBOL_TOKEN_ADDRESS=0x...
# BASE_SEPOLIA_OBOL_FAUCET_ADDRESS=0x...
# BASE_SEPOLIA_OBOL_FAUCET_AMOUNT="5 OBOL"
