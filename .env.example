# Example environment configuration for Obol Stack Frontend
# Copy this file to .env.local and adjust the values for your environment

# === For deployment inside Kubernetes cluster ===
# Service URLs using Kubernetes internal DNS
NEXT_PUBLIC_PROMETHEUS_URL=http://monitoring-kube-prometheus-prometheus.monitoring.svc.cluster.local:9090
NEXT_PUBLIC_ERPC_URL=https://obol.stack/rpc
NEXT_PUBLIC_HELIOS_CLIENT_URL=http://l1-light-client-helios.l1.svc.cluster.local:8545
NEXT_PUBLIC_FULL_NODE_BEACON_URL=http://l1-full-node-mainnet-beacon.l1.svc.cluster.local:5052
NEXT_PUBLIC_FULL_NODE_EXECUTION_URL=http://l1-full-node-mainnet-execution.l1.svc.cluster.local:8545

# Aztec L2 Service URLs
NEXT_PUBLIC_AZTEC_FULLNODE_URL=http://l2-full-node-sepolia-node.aztec-testnet.svc.cluster.local:8080
NEXT_PUBLIC_AZTEC_SEQUENCER_URL=http://localhost:8080
NEXT_PUBLIC_AZTEC_PROVER_NODE_URL=http://l2-prover-node-sepolia-node.aztec-testnet.svc.cluster.local:8080
NEXT_PUBLIC_AZTEC_PROVER_BROKER_URL=http://l2-prover-node-sepolia-broker.aztec-testnet.svc.cluster.local:8080
NEXT_PUBLIC_AZTEC_PROVER_AGENT_URL=http://l2-prover-node-sepolia-agent.aztec-testnet.svc.cluster.local:8080

# WalletConnect Project ID for RainbowKit
# NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# === For local development (outside cluster) ===
# Uncomment these when running locally with port-forwarding
# NEXT_PUBLIC_PROMETHEUS_URL=http://localhost:9090
# NEXT_PUBLIC_ERPC_URL=http://obol.stack
# NEXT_PUBLIC_HELIOS_CLIENT_URL=http://localhost:8545
# NEXT_PUBLIC_FULL_NODE_BEACON_URL=http://localhost:5052
# NEXT_PUBLIC_FULL_NODE_EXECUTION_URL=http://localhost:8545

# ADK Agent Configuration (server-side only, no NEXT_PUBLIC_ prefix)
ADK_AGENT_URL=http://localhost:8000
