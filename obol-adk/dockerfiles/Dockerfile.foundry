FROM ghcr.io/foundry-rs/foundry:latest

# Switch to root to install packages
USER root

# Install Node.js, git, and other dependencies
RUN apk add --no-cache nodejs npm git curl bash

# Install Bun
RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:${PATH}"

WORKDIR /app

# Clone and build the foundry-mcp-server
RUN git clone https://github.com/PraneshASP/foundry-mcp-server.git .
RUN bun i && bun build ./src/index.ts --outdir ./dist --target node

# Expose port if needed (not required for stdio)
EXPOSE 8080

# Run as root since the MCP server needs access to foundry binaries
CMD ["node", "./dist/index.js"]