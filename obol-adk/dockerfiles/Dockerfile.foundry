FROM ubuntu:latest

# Install dependencies including Node.js, git, curl, and build tools
RUN apt-get update && \
    apt-get install -y nodejs npm git curl bash unzip build-essential && \
    rm -rf /var/lib/apt/lists/*

# Install Foundry
# Using yes to automatically accept the installation
RUN curl -L https://foundry.paradigm.xyz | bash
# Source the foundryup script and run it
RUN /root/.foundry/bin/foundryup

# Add Foundry binaries to PATH
ENV PATH="/root/.foundry/bin:${PATH}"

# Install Bun
RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:${PATH}"

WORKDIR /app

# Add a build argument to bust the cache when the repo is updated
ARG REPO_COMMIT_HASH
# Clone and build the foundry-mcp-server
# The echo command ensures that if REPO_COMMIT_HASH changes, this layer is rebuilt.
RUN echo "Cloning foundry-mcp-server at commit: ${REPO_COMMIT_HASH:-latest}" && \
    git clone https://github.com/PraneshASP/foundry-mcp-server.git . && \
    bun i && bun build ./src/index.ts --outdir ./dist --target node

# Expose port if needed (not required for stdio)
EXPOSE 8080

# Run as root since the MCP server needs access to foundry binaries
CMD ["node", "./dist/index.js"]