# Dockerfile to run the Filesystem MCP server
FROM node:lts-slim

WORKDIR /app

# Preinstall the server so the image has no runtime dependencies
RUN npm install -g @modelcontextprotocol/server-filesystem

# Create a default data directory
RUN mkdir -p /data

EXPOSE 8080

# Launch the server with a default directory
# Users can mount their own directory at runtime with: -v /path/to/data:/data
CMD ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/data"]
