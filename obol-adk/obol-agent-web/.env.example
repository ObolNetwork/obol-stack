# Obol Agent Web Configuration
# Copy this file to .env and adjust values as needed

# Agent Configuration
OBOL_AGENT_MODEL=gemini-2.0-flash

# Workspace Paths
OBOL_WORKSPACE_PATH=/Users/bussyjd/Development/Obol_Workbench/obol-stack
OBOL_DOCS_PATH=/Users/bussyjd/Development/Obol_Workbench/obol-stack/obol-adk/docs

# Kubernetes Configuration
KUBECONFIG=/Users/bussyjd/.kube/config

# Obol MCP Server Configuration
OBOL_MCP_LOG_LEVEL=INFO
OBOL_CACHE_TTL=300
OBOL_API_BASE_URL=https://api.obol.tech
OBOL_REQUEST_TIMEOUT=15.0
OBOL_RATE_LIMIT_DELAY=0.1

# ADK Server Configuration
PORT=8080
LOG_LEVEL=INFO