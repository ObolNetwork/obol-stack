{
  "name": "obol-stack-front-end",
  "version": "0.1.29-rc0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "bash scripts/port-forward-erpc.sh & next dev --turbopack -H obol.stack -p 3000",
    "dev:local": "next dev --turbopack",
    "build": "next build",
    "start": "next start --hostname obol.stack",
    "start:local": "next start",
    "start:ci": "cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public && node .next/standalone/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/lib/services/*.test.mjs src/lib/marketplace/*.test.mjs src/lib/middleware/*.test.mjs src/lib/sell/*.test.mjs src/lib/utils/*.test.mjs src/hooks/*.test.mjs src/components/storefront/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "playwright codegen localhost:3000",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit"
  },
  "dependencies": {
    "@kubernetes/client-node": "2.0.2",
    "@obolnetwork/obol-ui": "1.7.1",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-tooltip": "1.4.1",
    "@rainbow-me/rainbowkit": "2.2.11",
    "@sinclair/typebox": "0.34.52",
    "@tanstack/react-query": "5.108.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-toastify": "11.2.0",
    "viem": "2.58.3",
    "wagmi": "3.7.11"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "eslint": "10.16.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "overrides": {
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "decode-uri-component@<0.5.1": "^0.5.1",
      "zod@<4.6.6": "^4.6.6"
    }
  }
}
