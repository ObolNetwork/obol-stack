# Example environment configuration for Obol Stack Frontend
# Copy to .env.local and adjust for your machine.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │ Local dev (`pnpm run dev` on the Mac host)                              │
# ├─────────────────────────────────────────────────────────────────────────┤
# │ REQUIRED (server-side only — not NEXT_PUBLIC_*)                           │
# │   KUBECONFIG — path to the obol kubeconfig file.                        │
# │   Without it, /api/dashboard returns 503 and the UI shows               │
# │   "Obol Stack unreachable". `obol kubectl` sets KUBECONFIG for you;    │
# │   Next.js does not — point this at the same file explicitly.             │
# │   Typical path: ~/.config/obol/kubeconfig.yaml                          │
# │   Alternative: OBOL_CONFIG_DIR=~/.config/obol (uses …/kubeconfig.yaml)   │
# │                                                                         │
# │ OPTIONAL (enrichment only — APIs still return 200 without these)        │
# │   NEXT_PUBLIC_ERPC_URL — browser wallet balances (auto-defaults to      │
# │     http://obol.stack:8080/rpc when UI is on obol.stack:3000).         │
# │   PROMETHEUS_URL — server-side only; node metrics + listing usage counts. │
# │     In-cluster pod default needs no override. Local dev: port-forward     │
# │     then PROMETHEUS_URL=http://localhost:9090                             │
# │   ERPC_BASE_URL — eRPC networks panel on the home dashboard.              │
# │     `pnpm run dev` auto-starts eRPC port-forward → localhost:14000;     │
# │     set ERPC_BASE_URL=http://127.0.0.1:14000 so the server uses it.     │
# │   MARKETPLACE_CATALOG_URL — override catalog fetch (default             │
# │     http://obol.stack:8080/api/services.json).                          │
# │                                                                         │
# │ NOT NEEDED for basic UI                                                 │
# │   Prometheus/eRPC warnings in the terminal are expected when the        │
# │   optional URLs above are unset — listings show "—" for metrics.        │
# └─────────────────────────────────────────────────────────────────────────┘
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │ In-cluster dev build (from the obol-stack repo root)                    │
# ├─────────────────────────────────────────────────────────────────────────┤
# │   source .envrc.local                                                   │
# │   just dev-frontend          # builds web/frontend, imports, restarts   │
# │   open http://obol.stack:8080                                           │
# │ No .env.local needed — the pod uses in-cluster DNS for Prometheus/eRPC. │
# │ (.env.local still supplies the WalletConnect ID to the image build.)    │
# └─────────────────────────────────────────────────────────────────────────┘

# === Required for local development (server-side) ===
# KUBECONFIG=/Users/you/.config/obol/kubeconfig.yaml
# OBOL_CONFIG_DIR=/Users/you/.config/obol

# === Optional local enrichment ===
# NEXT_PUBLIC_ERPC_URL=http://obol.stack:8080/rpc
# PROMETHEUS_URL=http://localhost:9090
# ERPC_BASE_URL=http://127.0.0.1:14000
# MARKETPLACE_CATALOG_URL=http://obol.stack:8080/api/services.json

# === In-cluster pod (set in deployment env, not copied to .env.local) ===
# PROMETHEUS_URL=http://monitoring-kube-prometheus-prometheus.monitoring.svc.cluster.local:9090
NEXT_PUBLIC_ERPC_URL=https://obol.stack/rpc

# WalletConnect Project ID for RainbowKit
# https://cloud.walletconnect.com
# NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Legacy local overrides (usually prefer ERPC_BASE_URL for server-side eRPC)
# NEXT_PUBLIC_ERPC_URL=http://obol.stack:8080/rpc

# ADK Agent (server-side only)
# ADK_AGENT_URL=http://obol-agent.agent.svc.cluster.local:8000/
# NEXT_PUBLIC_ADK_AGENT_URL=http://obol-agent.agent.svc.cluster.local:8000/

# Feature flags
# NEXT_PUBLIC_FEATURE_TAG_VERSION_SHA_COMMIT=false

# Running Obol CLI version (server-side; also published via obol-stack-config)
# OBOL_STACK_VERSION=0.14.0-rc0

# Base Sepolia OBOL test faucet (server runtime)
# BASE_SEPOLIA_OBOL_TOKEN_ADDRESS=0x...
# BASE_SEPOLIA_OBOL_FAUCET_ADDRESS=0x...
# BASE_SEPOLIA_OBOL_FAUCET_AMOUNT="5 OBOL"
