# Configuration via CLI flags
# Template fields populated by obol CLI during network installation

# @enum llama3.3:70b,llama3.2:3b,qwen2.5:72b,qwen2.5:7b,glm-4.7:cloud,deepseek-r1:7b,phi4:14b
# @default glm-4.7:cloud
# @description Ollama model to serve for inference
model: {{.Model}}

# @default 0.001
# @description USDC price per inference request
pricePerRequest: {{.PricePerRequest}}

# @description USDC recipient wallet address (EVM)
walletAddress: {{.WalletAddress}}

# @enum base,base-sepolia
# @default base-sepolia
# @description Blockchain network for x402 payments
chain: {{.Chain}}

# @default 8402
# @description Port for the x402 inference gateway
gatewayPort: {{.GatewayPort}}
