# Helios Light Client Network
# Provides an Ethereum light client that can be used as an RPC endpoint

# Configuration via CLI flags
# Template fields populated by obol CLI during network installation
values:
  # @enum mainnet
  # @default mainnet
  # @description Ethereum network (only mainnet supported currently)
  - network: {{.Network}}
    # @default http://testing.mainnet.beacon-api.nimbus.team
    # @description Consensus RPC endpoint URL
    consensusRpc: {{.ConsensusRpc}}
    # @default https://eth.drpc.org
    # @description Execution RPC endpoint URL
    executionRpc: {{.ExecutionRpc}}

---

repositories:
  - name: obol
    url: https://obolnetwork.github.io/helm-charts/

releases:
  - name: helios
    namespace: helios
    createNamespace: true
    chart: obol/helios
    version: 0.1.4
    values:
      - fullnameOverride: 'helios-{{ .Values.network }}'
      - helios:
          rpcBindIp: "0.0.0.0"
          rpcPort: 8545
          strictCheckpointAge: false
          network: '{{ .Values.network }}'
          consensusRpc: '{{ .Values.consensusRpc }}'
          executionRpc: '{{ .Values.executionRpc }}'

      - persistence:
          enabled: true
          size: 10Gi
          storageClass: local-path

      - ingress:
          enabled: true
          className: nginx
          annotations:
            nginx.ingress.kubernetes.io/rewrite-target: /$2
            nginx.ingress.kubernetes.io/use-regex: "true"
          hosts:
            - host: obol.stack
              paths:
                - path: /helios(/|$)(.*)
                  pathType: ImplementationSpecific
