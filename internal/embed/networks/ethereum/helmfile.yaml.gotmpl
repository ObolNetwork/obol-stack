{{- /* Deployments made by an older obol can name a client that is no longer
  pinned (ethereumjs). Fail clearly instead of inside the upstream chart. */}}
{{- if not (has .Values.executionClient (list "reth" "geth" "nethermind" "besu" "erigon")) }}
{{- fail (printf "execution client %q is no longer supported. Delete this deployment and reinstall with --execution-client reth, geth, nethermind, besu or erigon" .Values.executionClient) }}
{{- end }}
{{- /* `obol network stop` records stopped: true. Both clients then render
  with 0 replicas (PVCs and data are kept) until `obol network start`. */}}
{{- $replicas := 1 }}
{{- if (index .Values "stopped" | default false) }}{{ $replicas = 0 }}{{ end }}
{{- /* CPU requests (no CPU limits: throttling hurts block processing).
    mainnet  EL 2 CPU   CL 1 CPU
    testnets EL 500m    CL 500m
  Memory requests and limits come from obol network sync
  (internal/network/sizing.go: per network, mode and client; executionMemory
  / consensusMemory in values.yaml set the limit) as MiB in
  elMemoryRequestMi / elMemoryLimitMi / clMemoryRequestMi / clMemoryLimitMi.
  Without them (e.g. helmfile run by hand) no memory is set. Clients whose
  runtime doesn't read the cgroup limit are told it below: GOMEMLIMIT at 85%
  (geth, erigon, prysm), JVM heap at 60% (besu, teku), Node heap at 70%
  (lodestar), reth's cross-block cache at a quarter (max its 4 GiB default).
  Nethermind (.NET) sizes its heap from the limit itself. */}}
{{- $elCPU := "500m" }}
{{- $clCPU := "500m" }}
{{- if eq .Values.network "mainnet" }}
  {{- $elCPU = "2" }}
  {{- $clCPU = "1" }}
{{- end }}
{{- $elReqMi := index .Values "elMemoryRequestMi" | default 0 | int }}
{{- $elLimMi := index .Values "elMemoryLimitMi" | default 0 | int }}
{{- $clReqMi := index .Values "clMemoryRequestMi" | default 0 | int }}
{{- $clLimMi := index .Values "clMemoryLimitMi" | default 0 | int }}
repositories:
  - name: ethereum-helm-charts
    url: https://ethpandaops.github.io/ethereum-helm-charts
  - name: bedag
    url: https://bedag.github.io/helm-charts/

releases:
  # Create PVCs first - before the Ethereum node
  - name: ethereum-pvcs
    namespace: ethereum-{{ .Values.id }}
    createNamespace: true
    chart: .
    values:
      # Pass only the values needed for PVC creation
      - id: '{{ .Values.id }}'
        executionClient: '{{ .Values.executionClient }}'
        consensusClient: '{{ .Values.consensusClient }}'
        network: '{{ .Values.network }}'
        mode: '{{ (index .Values "mode" | default "full") }}'
        executionStorageSize: '{{ index .Values "executionStorageSize" | default "" }}'
        consensusStorageSize: '{{ index .Values "consensusStorageSize" | default "" }}'

  # Ethereum node (execution and consensus clients)
  # Uses the external ethereum-helm-charts/ethereum-node umbrella chart
  # Depends on ethereum-pvcs to ensure PVCs exist first
  - name: ethereum
    namespace: ethereum-{{ .Values.id }}
    createNamespace: true
    chart: ethereum-helm-charts/ethereum-node
    # renovate: datasource=helm depName=ethereum-node registryUrl=https://ethpandaops.github.io/ethereum-helm-charts
    version: 0.2.16
    needs: [ethereum-pvcs]
    values:
      # Network and checkpoint sync configuration
      #
      # global.clientArgs.networks.<network>.execution.reth is the upstream
      # umbrella chart's per-network reth args list. We APPEND to it rather
      # than overriding reth.extraArgs directly, because reth.extraArgs in
      # the umbrella chart is a templated string that looks up this very
      # list — overriding it would silently drop the --chain=<testnet> arg
      # that testnets depend on. Mainnet's upstream list is empty; testnets
      # are ["--chain=<network>"]. We carry those over verbatim and add
      # --full only when mode != archive.
      - global:
          main:
            network: '{{ .Values.network }}'
          checkpointSync:
            enabled: true
            addresses:
              mainnet: https://mainnet-checkpoint-sync.attestant.io
              sepolia: https://checkpoint-sync.sepolia.ethpandaops.io
              hoodi: https://checkpoint-sync.hoodi.ethpandaops.io
          {{- if eq .Values.executionClient "reth" }}
          clientArgs:
            networks:
              {{ .Values.network }}:
                execution:
                  reth:
                    {{- if ne .Values.network "mainnet" }}
                    - --chain={{ .Values.network }}
                    {{- end }}
                    {{- if ne (index .Values "mode" | default "full") "archive" }}
                    - --full
                    {{- else if eq (index .Values "pruneKind" | default "") "before" }}
                    # Partial archive: keep state, receipts and bodies from
                    # the requested block forward. Reth v2.3.0 and current
                    # main both support exact .before cutoffs for these
                    # segments, so avoid the coarser pre-merge preset.
                    - --prune.account-history.before={{ .Values.pruneBlock }}
                    - --prune.storage-history.before={{ .Values.pruneBlock }}
                    - --prune.receipts.before={{ .Values.pruneBlock }}
                    - --prune.bodies.before={{ .Values.pruneBlock }}
                    {{- else if eq (index .Values "pruneKind" | default "") "distance" }}
                    # Partial archive: keep last N blocks of state, receipts
                    # and bodies. Reth interprets .distance as anchored to
                    # the chain tip at run time.
                    - --prune.account-history.distance={{ .Values.pruneDistance }}
                    - --prune.storage-history.distance={{ .Values.pruneDistance }}
                    - --prune.receipts.distance={{ .Values.pruneDistance }}
                    - --prune.bodies.distance={{ .Values.pruneDistance }}
                    {{- end }}
                    {{- if $elLimMi }}
                    - --engine.cross-block-cache-size={{ min 4096 (div $elLimMi 4) }}
                    {{- end }}
          {{- end }}

      # Execution client (pinned versions — Renovate-tracked)
      # Reth defaults to archive (~4TB+ mainnet). The --mode flag controls
      # whether we pass --full to prune historical state down to ~500GB,
      # wired through global.clientArgs above (NOT reth.extraArgs — see
      # comment above).
      - {{ .Values.executionClient }}:
          enabled: true
          replicas: {{ $replicas }}
          resources:
            requests:
              cpu: {{ $elCPU | quote }}
              {{- if $elReqMi }}
              memory: {{ printf "%dMi" $elReqMi | quote }}
              {{- end }}
            {{- if $elLimMi }}
            limits:
              memory: {{ printf "%dMi" $elLimMi | quote }}
            {{- end }}
          {{- if and $elLimMi (has .Values.executionClient (list "geth" "erigon" "besu")) }}
          extraEnv:
            {{- if eq .Values.executionClient "besu" }}
            - name: JAVA_OPTS
              value: -XX:MaxRAMPercentage=60
            {{- else }}
            - name: GOMEMLIMIT
              value: {{ printf "%dMiB" (div (mul $elLimMi 85) 100) | quote }}
            {{- end }}
          {{- end }}
          image:
            {{- if eq .Values.executionClient "reth" }}
            # renovate: datasource=github-releases depName=paradigmxyz/reth
            tag: v2.7.0
            {{- else if eq .Values.executionClient "geth" }}
            # renovate: datasource=github-releases depName=ethereum/go-ethereum
            tag: v1.17.8
            {{- else if eq .Values.executionClient "nethermind" }}
            # renovate: datasource=github-releases depName=NethermindEth/nethermind
            tag: "2.1.0"
            {{- else if eq .Values.executionClient "besu" }}
            # renovate: datasource=github-releases depName=hyperledger/besu
            tag: "26.9.0"
            {{- else if eq .Values.executionClient "erigon" }}
            # renovate: datasource=github-releases depName=erigontech/erigon
            tag: v3.7.1
            {{- end }}
          {{- if eq .Values.executionClient "reth" }}
          # reth keeps p2p (30303) closed while running post-crash consistency
          # recovery, which can exceed any bounded probe window on a large
          # datadir. The chart's default tcp liveness probe then SIGKILLs it
          # mid-recovery, forcing a longer recovery on the next start — a
          # permanent crash loop. A genuinely dead process exits the container
          # on its own, so make the probe effectively never fire.
          livenessProbe:
            tcpSocket:
              port: p2p-tcp
            initialDelaySeconds: 60
            periodSeconds: 120
            failureThreshold: 10000
          {{- end }}
          persistence:
            enabled: true
            size: {{ if (index .Values "executionStorageSize" | default "") }}{{ index .Values "executionStorageSize" }}{{ else }}{{ if eq .Values.network "mainnet" }}{{ if eq (index .Values "mode" | default "full") "archive" }}4500Gi{{ else }}500Gi{{ end }}{{ else }}{{ if eq (index .Values "mode" | default "full") "archive" }}300Gi{{ else }}100Gi{{ end }}{{ end }}{{ end }}
            existingClaim: execution-{{ .Values.executionClient }}-{{ .Values.network }}
          # Scraped by the stack's kube-prometheus-stack, which only selects
          # monitors labelled release=monitoring (values/monitoring.yaml.gotmpl).
          serviceMonitor:
            enabled: true
            labels:
              release: monitoring

      # Consensus client (pinned versions — Renovate-tracked)
      # The upstream chart wires --execution-endpoint and --network automatically.
      # No builder/relay wiring: blocks are built locally before Gloas (ePBS)
      # and builder bids arrive over p2p after it. Pins are stable releases
      # only; lighthouse and grandine are Gloas-ready only in pre-releases.
      # Exception: silver (gattaca-com) has only alpha releases so far, and its
      # image is linux/amd64 only (no Apple Silicon / arm64 node).
      - {{ .Values.consensusClient }}:
          enabled: true
          replicas: {{ $replicas }}
          resources:
            requests:
              cpu: {{ $clCPU | quote }}
              {{- if $clReqMi }}
              memory: {{ printf "%dMi" $clReqMi | quote }}
              {{- end }}
            {{- if $clLimMi }}
            limits:
              memory: {{ printf "%dMi" $clLimMi | quote }}
            {{- end }}
          {{- $clHeap := and $clLimMi (has .Values.consensusClient (list "prysm" "teku" "lodestar")) }}
          {{- if or $clHeap (eq .Values.consensusClient "silver") }}
          extraEnv:
            {{- if eq .Values.consensusClient "silver" }}
            # Silver logs only errors unless RUST_LOG is set.
            - name: RUST_LOG
              value: info
            {{- else if eq .Values.consensusClient "prysm" }}
            - name: GOMEMLIMIT
              value: {{ printf "%dMiB" (div (mul $clLimMi 85) 100) | quote }}
            {{- else if eq .Values.consensusClient "teku" }}
            - name: JAVA_OPTS
              value: -XX:MaxRAMPercentage=60
            {{- else if eq .Values.consensusClient "lodestar" }}
            # The image defaults to --max-old-space-size=8192, above most limits.
            - name: NODE_OPTIONS
              value: {{ printf "--max-old-space-size=%d" (div (mul $clLimMi 70) 100) | quote }}
            {{- end }}
          {{- end }}
          image:
            {{- if eq .Values.consensusClient "lighthouse" }}
            # renovate: datasource=github-releases depName=sigp/lighthouse
            tag: v8.2.3
            {{- else if eq .Values.consensusClient "prysm" }}
            # renovate: datasource=github-releases depName=OffchainLabs/prysm
            tag: v7.2.1
            {{- else if eq .Values.consensusClient "teku" }}
            # renovate: datasource=github-releases depName=Consensys/teku
            tag: "26.10.0"
            {{- else if eq .Values.consensusClient "nimbus" }}
            # renovate: datasource=docker depName=statusim/nimbus-eth2
            tag: multiarch-v26.10.0
            {{- else if eq .Values.consensusClient "lodestar" }}
            # renovate: datasource=github-releases depName=ChainSafe/lodestar
            tag: v1.50.1
            {{- else if eq .Values.consensusClient "grandine" }}
            # renovate: datasource=docker depName=sifrai/grandine
            tag: "2.0.6"
            {{- else if eq .Values.consensusClient "silver" }}
            # renovate: datasource=github-releases depName=gattaca-com/silver
            tag: v0.1.0-alpha.13
            {{- end }}
          {{- if eq .Values.consensusClient "silver" }}
          # The chart's tcpSocket probes call Silver ready while its beacon API accepts
          # connections but answers nothing (seen while it waited on a
          # checkpoint). Readiness asks the API instead; /node/health is 206
          # while syncing, which counts as ready. Startup and liveness ask
          # /node/version, so a boot that stalls before the first engine-API
          # exchange (no answer for 30 min) or an API that stops answering
          # (6 min) gets the container restarted. Same probes as
          # ethpandaops/ethereum-helm-charts#505; drop these once it ships.
          startupProbe:
            tcpSocket: null
            httpGet:
              path: /eth/v1/node/version
              port: http-api
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 180
          livenessProbe:
            tcpSocket: null
            httpGet:
              path: /eth/v1/node/version
              port: http-api
            periodSeconds: 120
            timeoutSeconds: 5
          readinessProbe:
            tcpSocket: null
            httpGet:
              path: /eth/v1/node/health
              port: http-api
            periodSeconds: 10
            timeoutSeconds: 5
          {{- end }}
          persistence:
            enabled: true
            size: {{ if (index .Values "consensusStorageSize" | default "") }}{{ index .Values "consensusStorageSize" }}{{ else }}{{ if eq .Values.network "mainnet" }}{{ if eq (index .Values "mode" | default "full") "archive" }}500Gi{{ else }}200Gi{{ end }}{{ else }}{{ if eq (index .Values "mode" | default "full") "archive" }}100Gi{{ else }}50Gi{{ end }}{{ end }}{{ end }}
            existingClaim: consensus-{{ .Values.consensusClient }}-{{ .Values.network }}
          # Scraped by the stack's kube-prometheus-stack, which only selects
          # monitors labelled release=monitoring (values/monitoring.yaml.gotmpl).
          serviceMonitor:
            enabled: true
            labels:
              release: monitoring

  # Metadata ConfigMap for frontend discovery
  - name: ethereum-metadata
    namespace: ethereum-{{ .Values.id }}
    chart: bedag/raw
    values:
      - resources:
          - apiVersion: v1
            kind: ConfigMap
            metadata:
              name: ethereum-{{ .Values.id }}-metadata
              namespace: ethereum-{{ .Values.id }}
              labels:
                app.kubernetes.io/part-of: obol.stack
                obol.stack/id: {{ .Values.id }}
                obol.stack/app: ethereum
            data:
              metadata.json: |
                {
                  "network": "{{ .Values.network }}",
                  "chainId": {{ if eq .Values.network "mainnet" }}1{{ else if eq .Values.network "hoodi" }}560048{{ else if eq .Values.network "sepolia" }}11155111{{ else }}0{{ end }},
                  "execution": {
                    "client": "{{ .Values.executionClient }}",
                    "endpoints": {
                      "rpc": {
                        "internal": "http://ethereum-execution.ethereum-{{ .Values.id }}.svc.cluster.local:8545"
                      }
                    }
                  },
                  "consensus": {
                    "client": "{{ .Values.consensusClient }}",
                    "endpoints": {
                      "rpc": {
                        "internal": "http://ethereum-beacon.ethereum-{{ .Values.id }}.svc.cluster.local:5052"
                      }
                    }
                  }
                }
