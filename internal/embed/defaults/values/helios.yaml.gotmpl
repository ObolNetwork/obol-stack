{{- $network := .Values.network -}}
# fullnameOverride creates network-specific resources:
# - StatefulSet: helios-{{ $network }}
# - Service: helios-{{ $network }}
# - PVC: data-helios-{{ $network }}-0 (via volumeClaimTemplates)
fullnameOverride: helios-{{ $network }}

# IMPORTANT: Checkpoint must be the block root of the FIRST slot of an epoch
# To get a valid checkpoint:
# 1. Find a finalized slot from beacon explorer (e.g., beaconcha.in)
# 2. Calculate epoch: epoch = slot ÷ 32 (round down)
# 3. Get first slot of epoch: first_slot = epoch × 32
# 4. Fetch block root from: {consensus_rpc}/eth/v1/beacon/headers/{first_slot}
# Example: slot 8880895 → epoch 277527 → first_slot 8880864

helios:
  rpcBindIp: "0.0.0.0"
  rpcPort: 8545
  strictCheckpointAge: false
{{- if eq $network "mainnet" }}
  network: mainnet
  consensusRpc: "http://testing.mainnet.beacon-api.nimbus.team"
  executionRpc: "https://eth.drpc.org"
  checkpoint: ""

# NOTE: Only able to support mainnet as of writing due to unreliability of public endpoints which warrants further investigation

{{- else }}
{{- fail (printf "Unknown network: %s. Supported networks: mainnet" $network) }}
{{- end }}

persistence:
  enabled: true
  size: 10Gi
  storageClass: local-path

ingress:
  enabled: true
  className: nginx
  hosts:
    - host: helios.obol.stack
      paths:
        - path: /
          pathType: Prefix
