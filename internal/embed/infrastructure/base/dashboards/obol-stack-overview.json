  {
   "type": "gauge",
   "title": "Disk used",
   "description": "`/` is the node's writable layer (image/container storage \u2014 kubelet evicts pods under DiskPressure when it fills); `/data` is the stack data dir (PVCs: chain data, Prometheus, agent state).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (mountpoint) (1 - node_filesystem_avail_bytes{mountpoint=~\"/|/data\"} / node_filesystem_size_bytes{mountpoint=~\"/|/data\"})",
     "refId": "A",
     "legendFormat": "{{mountpoint}}",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "color": {
      "mode": "thresholds"
     },
