  {
   "type": "stat",
   "title": "EL blocks behind",
   "description": "Highest known block minus head. A true sync target only for nethermind and besu (ethereum_best_known_block_number). geth (chain_head_header), reth (Headers stage checkpoint) and erigon (headers stage) use the downloaded-headers height as a proxy; 0 does not prove those are at the network tip \u2014 check that the head is advancing.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "clamp_min(max by (container) (ethereum_best_known_block_number{namespace=\"$namespace\", job=\"ethereum-execution\"} or chain_head_header{namespace=\"$namespace\", job=\"ethereum-execution\"} or reth_sync_checkpoint{stage=\"Headers\", namespace=\"$namespace\", job=\"ethereum-execution\"} or sync{stage=\"headers\", namespace=\"$namespace\", job=\"ethereum-execution\"}) - max by (container) (chain_head_block{namespace=\"$namespace\", job=\"ethereum-execution\"} or reth_blockchain_tree_canonical_chain_height{namespace=\"$namespace\", job=\"ethereum-execution\"} or ethereum_blockchain_height{namespace=\"$namespace\", job=\"ethereum-execution\"} or sync{stage=\"execution\", namespace=\"$namespace\", job=\"ethereum-execution\"}), 0)",
     "refId": "A",
     "legendFormat": "{{container}}",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 2
       },
       {
        "color": "red",
        "value": 64
       }
      ]
     },
     "mappings": [],
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
