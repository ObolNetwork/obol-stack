{
  "name": "obol-stack-front-end",
  "version": "0.1.28-rc4",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "bash scripts/port-forward-erpc.sh & next dev --turbopack -H obol.stack -p 3000",
    "dev:local": "next dev --turbopack",
    "build": "next build",
    "start": "next start --hostname obol.stack",
    "start:local": "next start",
    "start:ci": "cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public && node .next/standalone/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/lib/services/*.test.mjs src/lib/marketplace/*.test.mjs src/lib/middleware/*.test.mjs src/lib/sell/*.test.mjs src/lib/utils/*.test.mjs src/hooks/*.test.mjs src/components/storefront/*.test.mjs",
    "scan:secrets": "gitleaks detect --source=. --config=.gitleaks.toml --redact",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "playwright codegen localhost:3000",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.57",
    "@copilotkit/react-core": "1.62.3",
    "@copilotkit/react-ui": "1.62.3",
    "@copilotkit/runtime": "1.62.3",
    "@kubernetes/client-node": "1.4.0",
    "@obolnetwork/obol-ui": "1.1.21",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-tooltip": "1.2.12",
    "@rainbow-me/rainbowkit": "2.2.11",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@sinclair/typebox": "0.34.52",
    "@stitches/react": "1.2.8",
    "@tanstack/react-query": "5.101.2",
    "dompurify": "3.4.12",
    "next": "16.2.10",
    "pino": "10.3.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.81.0",
    "react-toastify": "11.1.0",
    "shiki": "4.3.1",
    "thread-stream": "4.2.0",
    "value": "link:@sinclair/typebox/value",
    "viem": "2.54.6",
    "wagmi": "3.6.21"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.2.10",
    "@playwright/test": "1.61.1",
    "@types/dompurify": "3.2.0",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "prettier": "3.9.4",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "pino": "^10.1.1",
      "thread-stream": "^4.0.0"
    }
  }
}
