{
  "name": "obol-stack-front-end",
  "version": "0.1.29-rc0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "bash scripts/port-forward-erpc.sh & next dev --turbopack -H obol.stack -p 3000",
    "dev:local": "next dev --turbopack",
    "build": "next build",
    "start": "next start --hostname obol.stack",
    "start:local": "next start",
    "start:ci": "cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public && node .next/standalone/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/lib/services/*.test.mjs src/lib/marketplace/*.test.mjs src/lib/middleware/*.test.mjs src/lib/sell/*.test.mjs src/lib/utils/*.test.mjs src/hooks/*.test.mjs src/components/storefront/*.test.mjs",
    "scan:secrets": "gitleaks detect --source=. --config=.gitleaks.toml --redact",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "playwright codegen localhost:3000",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit"
  },
  "dependencies": {
    "@kubernetes/client-node": "2.0.0",
    "@obolnetwork/obol-ui": "1.1.24",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-tooltip": "1.2.16",
    "@rainbow-me/rainbowkit": "2.2.11",
    "@sinclair/typebox": "0.34.52",
    "@stitches/react": "1.2.8",
    "@tanstack/react-query": "5.104.1",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-toastify": "11.1.0",
    "viem": "2.57.3",
    "wagmi": "3.7.7"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.3.8",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "browserslist@<4.28.7": "^4.28.7",
      "baseline-browser-mapping@<2.11.0": "^2.11.0",
      "@babel/core@<7.29.6": "^7.29.6",
      "ip-address@<10.7.1": "^10.7.1",
      "decode-uri-component@<0.5.0": "^0.5.0",
      "ua-parser-js@>=2.0.1 <2.0.10": "^2.0.10",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=5.0.0 <5.0.12": "^5.0.12",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2"
    }
  }
}
