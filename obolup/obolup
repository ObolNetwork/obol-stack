    log_info "Configuring the Obol Stack Ethereum client..."
    ensure helm upgrade  --namespace l1 --create-namespace --hide-notes --install l1-light-client obol/helios
    ensure helm upgrade --namespace l1 --create-namespace --install l1-rpc ethereum/erpc --values ./values/erpc.yaml

    ensure helm upgrade --namespace l1 --create-namespace --install l1-erigon ethereum/erigon --values ./values/erigon.yaml

    # Todo(Oisin): EthpandaOps/ethereum-node not flexible enough just yet, installing clients directly with their dedicated chart
    #ensure helm upgrade --namespace l1 --create-namespace --install --set erigon.enabled=true l1-erigon ethereum/ethereum-node 
    # Todo(Oisin): Blockscout segfaulting, unclear why
    # ensure obol install ethereum/blockscout --values ./values/blockscout.yaml

    # Check stack health
    log_info "Checking stack health..."
    # if ! kubectl get pods -n obol-system -o jsonpath='{.items[*].status.phase}' | grep -q "Running"; then
    #     log_error "Obol Stack is not healthy. Check logs with: kubectl logs -n obol-system"
    # fi

    # Launch status page
    log_info "Launching Obol Stack Dashboard at http://localhost:$STATUS_PORT..."
    #kubectl -n kubernetes-dashboard port-forward svc/kubernetes-dashboard-kong-proxy $STATUS_PORT:443 &
    #xdg-open "https://localhost:$STATUS_PORT" 2>/dev/null || open "http://localhost:$STATUS_PORT" 2>/dev/null || log_warn "Could not open browser automatically."
}

# Main logic
main() {
    # Instantiate
    local network=""
	local mode=""
    declare -i clean=0

	# Parse the CLI flags
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--help) help 0 ;;
		--network)
			network="$2"
			shift 2
			;;
        --mode)
			mode="$2"
			shift 2
			;;
        --clean)
			clean=1
			shift 1
			;;
        *)
			echo "Unknown option: $1" >&2
			help
			;;
		esac
	done

    banner

    # Parse network and sync mode
    validate_network network
	validate_sync_mode mode

    log_info "Starting obolup..."
    log_info "Detected platform: $PLATFORM"
    log_info "Detected architecture: $ARCHITECTURE"
    log_info "Selected network: $network"
    log_info "Selected node type: $mode"
    # start_docker
    start_docker
    install_kubectl
    install_kind
    install_helm
    #install_obol_cli
    #check_obolup_update
    if [[ "$clean" -ne 0 ]]; then
        log_info "Clean command specified, deleting and recreating Obol Stack resources..."
        kind delete cluster --name "$STACK_NAME"
    fi

    launch_stack

    log_info "Obol Stack is up and running!"
    exit 0
}


