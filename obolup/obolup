#!/usr/bin/env bash

# modified from https://github.com/foundry-rs/foundry/blob/master/foundryup/foundryup

# obolup - Obol Stack Updater and Launcher

set -Eeuo pipefail


# Constants
readonly OBOL_CLI_REPO="https://github.com/obolnetwork/obol-cli"
readonly KIND_VERSION="v0.27.0"
readonly OBOLUP_URL="https://stack.obol.org/obolup"
readonly STACK_NAME="obol-stack"

# Colors for output
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m' # No Color

# Network name to chain ID mapping
declare -A -r SUPPORTED_NETWORKS=(
	["hoodi"]="560048"
    ["mainnet"]="1"
)
# Supported sync types
declare -A -r SUPPORTED_MODES=(
	["light"]=1
    ["full"]=2
)

readonly BASE_DIR=${XDG_CONFIG_HOME:-$HOME}

tolower() {
  echo "$1" | awk '{print tolower($0)}'
}

# Get platform + architecture
readonly uname_s=$(uname -s)
PLATFORM=$(tolower "${OBOLUP_PLATFORM:-$uname_s}")
ARCHITECTURE=unset
EXT="tar.gz"
case $PLATFORM in
    linux) ;;
    darwin|mac*)
    PLATFORM="darwin"
    ;;
    mingw*|win*)
    EXT="zip"
    PLATFORM="win32"
    ;;
    *)
    log_error "unsupported platform: $PLATFORM"
    ;;
esac

readonly uname_m=$(uname -m)
ARCHITECTURE=$(tolower "${OBOLUP_ARCH:-$uname_m}")
if [ "${ARCHITECTURE}" = "x86_64" ]; then
    # Redirect stderr to /dev/null to avoid printing errors if non Rosetta.
    if [ "$(sysctl -n sysctl.proc_translated 2>/dev/null)" = "1" ]; then
    ARCHITECTURE="arm64" # Rosetta.
    else
    ARCHITECTURE="amd64" # Intel.
    fi
elif [ "${ARCHITECTURE}" = "arm64" ] ||[ "${ARCHITECTURE}" = "aarch64" ] ; then
    ARCHITECTURE="arm64" # Arm.
else
    ARCHITECTURE="amd64" # Amd.
fi


# Run a command that should never fail. If the command fails execution
# will immediately terminate with an error showing the failing command.
ensure() {
  if ! "$@"; then log_error "command failed: $*"; fi
}

# Downloads $1 into $2 or stdout
download() {
  if [ -n "$2" ]; then
    # output into $2
    if command_exists curl; then
      curl -#o "$2" -L "$1"
    else
      wget --show-progress -qO "$2" "$1"
    fi
  else
    # output to stdout
    if command_exists curl; then
      curl -#L "$1"
    else
      wget --show-progress -qO- "$1"
    fi
  fi
}

# Validate the network
validate_network() {
	declare -n __network="$1"

	if [[ -z "$__network" ]]; then
		log_info "Network name is empty. Defaulting to mainnet"
        __network="mainnet"
	fi

	if [[ -z "${SUPPORTED_NETWORKS[$__network]:-}" ]]; then
		log_warn "Unrecognised network name: \"${__network}\".\n"
		help 1
	fi
}

# Validate the sync mode
validate_sync_mode() {
	declare -n __mode="$1"

	if [[ -z "$__mode" ]]; then
		log_info "Sync mode is empty. Defaulting to light node sync mode."
        __mode="light"
	fi

	if [[ -z "${SUPPORTED_MODES[$__mode]:-}" ]]; then
		log_warn "Unrecognised sync mode: \"${__mode}\".\n"
		help 1
	fi
}

# Log functions
log_info() { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }

# Check if a command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Ensure Docker is running
start_docker() {
    log_info "Checking Docker..."
    if ! command_exists docker; then
        log_error "Docker is not installed. Please install Docker first."
    fi
    if ! docker info >/dev/null 2>&1; then
        log_info "Starting Docker..."
        if [ "${PLATFORM}" = "linux" ]; then
            sudo systemctl start docker || log_error "Failed to start Docker."
        elif [ "${PLATFORM}" = "darwin" ]; then
            open -jga Docker
        else
            log_error "Failed to start Docker."
        fi
    fi
    log_info "Docker is running."
}

# Install or update kubectl
install_kubectl() {
    log_info "Checking kubectl..."
    # Check if kubectl is already installed
    if command_exists kubectl; then
        log_info "kubectl is already installed."
    else
        log_info "Installing kubectl..."
        # Download the latest release
        ensure curl -sSLO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/$ARCHITECTURE/kubectl"

        # Validate the binary (optional)
        ensure curl -sSLO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/$ARCHITECTURE/kubectl.sha256"
        echo "$(cat kubectl.sha256)  kubectl" | sha256sum --check || log_warn "kubectl checksum validation failed. Continuing anyway..."

        # Install kubectl
        ensure sudo install -o root -g root -m 0755 kubectl /usr/local/bin/kubectl

        # Clean up
        rm -f kubectl kubectl.sha256

        log_info "kubectl installed successfully."
    fi
}

# Install or update Helm
install_helm() {
    log_info "Checking helm..."

    # Fetch and extract the latest helm release version
    LATEST_RELEASE=$(curl -s "https://api.github.com/repos/helm/helm/releases/latest" 2>/dev/null | grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/')

    # Check if we got a version (network connectivity)
    if [[ -z "$LATEST_RELEASE" ]]; then
        log_warn "Unable to fetch latest helm version. Network may be unavailable."
        if command_exists helm; then
            log_info "helm is already installed. Skipping update check. Version installed: $(helm version --short 2>/dev/null || echo 'unknown')"
            return
        else
            log_error "helm is not installed and unable to fetch latest version. Please check your internet connection."
        fi
    fi

    log_info "Latest helm version available: $LATEST_RELEASE"

    # Check if helm is already installed
    if command_exists helm; then
        log_info "helm is already installed. Version installed: $(helm version --short 2>/dev/null || echo 'unknown')"
    else
        log_info "helm is not installed."
        log_info "Installing helm..."
        # Download the latest release
        ensure curl -sSL -O "https://get.helm.sh/helm-$LATEST_RELEASE-$PLATFORM-$ARCHITECTURE.tar.gz"

        # Validate the binary (optional)
        ensure curl -sSLo helm.tar.gz.sha256sum "https://get.helm.sh/helm-$LATEST_RELEASE-$PLATFORM-$ARCHITECTURE.tar.gz.sha256sum"
        echo "$(cat helm.tar.gz.sha256sum)" | sha256sum --check --status || log_error "helm checksum validation failed. helm installation failed."

        # Proceed to install
        ensure tar -xzf helm-$LATEST_RELEASE-$PLATFORM-$ARCHITECTURE.tar.gz
        ensure chmod +x ./$PLATFORM-$ARCHITECTURE/helm
        ensure sudo mv ./$PLATFORM-$ARCHITECTURE/helm /usr/local/bin/
        rm helm-$LATEST_RELEASE-$PLATFORM-$ARCHITECTURE.tar.gz helm.tar.gz.sha256sum
        rm -r ./$PLATFORM-$ARCHITECTURE

        log_info "helm installed successfully."
    fi
}

# Install or update Kind
install_kind() {
    log_info "Checking Kind..."
    if ! command_exists kind || [[ "$(kind version | grep -o 'v[0-9]\+\.[0-9]\+\.[0-9]\+')" != "$KIND_VERSION" ]]; then
        log_info "Installing Kind $KIND_VERSION..."
        ensure curl -sSLo ./kind "https://kind.sigs.k8s.io/dl/$KIND_VERSION/kind-$PLATFORM-$ARCHITECTURE"
        chmod +x ./kind
        sudo mv ./kind /usr/local/bin/kind
    fi
    log_info "Kind $KIND_VERSION is installed."
}

# Install or update k9s
install_k9s() {
    log_info "Checking k9s..."

    # Fetch and extract the latest k9s release version
    log_info "Fetching latest k9s version from GitHub API..."
    LATEST_K9S_VERSION=$(curl -s "https://api.github.com/repos/derailed/k9s/releases/latest" 2>/dev/null | grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/')

    # Check if we got a version (network connectivity)
    if [[ -z "$LATEST_K9S_VERSION" ]]; then
        log_warn "Unable to fetch latest k9s version. Network may be unavailable."
        if command_exists k9s; then
            log_info "k9s is already installed. Skipping update check."
            return
        else
            log_error "k9s is not installed and unable to fetch latest version. Please check your internet connection."
        fi
    fi

    log_info "Latest k9s version available: $LATEST_K9S_VERSION"

    # Check if k9s is already installed
    if command_exists k9s; then
        # Extract version number (k9s doesn't use 'v' prefix in version output)
        INSTALLED_VERSION=$(k9s version --short 2>/dev/null | head -n1 | awk '{print $2}')
        if [[ -n "$INSTALLED_VERSION" ]]; then
            # Add 'v' prefix to match release format
            INSTALLED_VERSION="v$INSTALLED_VERSION"
            log_info "k9s is already installed. Version installed: $INSTALLED_VERSION"
            if [[ "$INSTALLED_VERSION" == "$LATEST_K9S_VERSION" ]]; then
                log_info "k9s is up to date."
                return
            else
                # Check if the k9s version is installed as we expect
                local k9s_path=$(which k9s)
                if [[ "$k9s_path" != "/usr/local/bin/k9s" ]]; then
                
                    log_info "k9s is installed at $k9s_path (managed by a package manager)"
                    log_info "If you want the latest version, consider updating through your package manager"
                    return
                fi
            fi
        else
            log_warn "k9s is installed but version could not be determined."
        fi
    fi

    log_info "Installing k9s $LATEST_K9S_VERSION..."

    # Download the latest release
    # k9s uses capital case for platform names (Linux, Darwin)
    if [[ "$PLATFORM" == "linux" ]]; then
        K9S_PLATFORM="Linux"
    elif [[ "$PLATFORM" == "darwin" ]]; then
        K9S_PLATFORM="Darwin"
    else
        log_error "Unsupported platform for k9s: $PLATFORM"
    fi

    K9S_FILENAME="k9s_${K9S_PLATFORM}_${ARCHITECTURE}.tar.gz"
    K9S_URL="https://github.com/derailed/k9s/releases/download/$LATEST_K9S_VERSION/$K9S_FILENAME"

    log_info "Downloading k9s from: $K9S_URL"
    if ! curl -sSL -O "$K9S_URL"; then
        log_error "Failed to download k9s from $K9S_URL. Please check the URL and your internet connection."
    fi

    # Extract and install
    log_info "Extracting and installing k9s..."
    if ! tar -xzf "$K9S_FILENAME" 2>/dev/null; then
        log_error "Failed to extract $K9S_FILENAME. The download may be corrupted."
    fi

    if [[ ! -f "k9s" ]]; then
        log_error "k9s binary not found after extraction. Archive contents may be unexpected."
    fi

    ensure chmod +x k9s
    ensure sudo mv k9s /usr/local/bin/

    # Clean up
    rm -f "$K9S_FILENAME" README.md LICENSE

    log_info "k9s $LATEST_K9S_VERSION installed successfully."
}

# Install or update obol CLI
install_obol_cli() {
    log_info "Checking obol CLI..."
    LATEST_OBOL_VERSION=$(ensure curl -sS "$OBOL_CLI_REPO/releases/latest" | grep -o 'v[0-9]\+\.[0-9]\+\.[0-9]\+')
    log_info "Latest Obol CLI version is $LATEST_OBOL_VERSION"
    if ! command_exists obol || [[ "$(obol --version >/dev/null 2>&1)" != *"$LATEST_OBOL_VERSION"* ]]; then
        log_info "Installing obol CLI $LATEST_OBOL_VERSION..."
        ensure curl -sSLo obol.tar.gz "$OBOL_CLI_REPO/releases/download/$LATEST_OBOL_VERSION/obol-$PLATFORM-$ARCHITECTURE.tar.gz"
        tar -xzf obol.tar.gz
        chmod +x obol
        sudo mv obol /usr/local/bin/
        rm obol.tar.gz
    fi
    log_info "Obol CLI $LATEST_OBOL_VERSION is installed."
}

# Check for obolup updates (warn only, don’t update)
check_obolup_update() {
    log_info "Checking for obolup updates..."
    REMOTE_HASH=$(curl -s "$OBOLUP_URL" | sha256sum | awk '{print $1}')
    LOCAL_HASH=$(sha256sum "$0" | awk '{print $1}')
    if [[ "$REMOTE_HASH" != "$LOCAL_HASH" ]]; then
        log_warn "A newer version of obolup is available. Run: sh <(curl https://stack.obol.org/sh)"
    else
        log_info "obolup is up to date."
    fi
}

# Check if cluster has required port mappings to run exposed services, or whether it was first created in --headless mode
check_cluster_port_mappings() {
    local cluster_name="$1"
    # Check if the cluster has port 80 and 443 mapped
    local port_mappings=$(docker inspect "${cluster_name}-control-plane" 2>/dev/null | grep -E '"HostPort": "(80|443)"' | wc -l)
    if [[ "$port_mappings" -ge 2 ]]; then
        return 0  # Has port mappings
    else
        return 1  # No port mappings
    fi
}

# Launch or update the Obol Stack
launch_stack() {
    declare -n __network="$1"
    declare -n __mode="$2"
    declare -n __headless="$3"

    log_info "Launching core Obol Stack services..."
    if ! kind get clusters | grep -q "$STACK_NAME"; then
        # If headless=1, map host port 80 and 443 into the cluster and enable an ingress-controller and some default routes
        if [[ "$__headless" -ne 0 ]]; then
            log_info "Creating Kind cluster for Obol Stack in headless mode..."
            kind create cluster --name "$STACK_NAME" --config ./manifests/kind_headless.yaml
        else
            log_info "Creating Kind cluster for Obol Stack..."
            kind create cluster --name "$STACK_NAME" --config ./manifests/kind_host.yaml
        fi
    else
        # Cluster exists, check if we need host mode but don't have port mappings
        if [[ "$__headless" -eq 0 ]] && ! check_cluster_port_mappings "$STACK_NAME"; then
            log_warn "Existing cluster doesn't have the required port mappings to expose web services."
            log_warn "The cluster needs to be recreated without the --headless flag."
            log_info "Please run: ./obolup --clean"
            log_error "Cannot proceed without proper port mappings. Exiting."
        fi
    fi

    # Apply base Obol Stack resources (e.g., namespaces, monitoring)
    #log_info "Applying Obol Stack base resources..."
    #kubectl apply -f https://stack.obol.org/base.yaml || log_error "Failed to apply base resources."

    # Add the appropriate Helm repos (ethpandaops, Obol, monitoring...)
    log_info "Adding default Obol Stack app stores..."
    ensure helm repo add ethereum https://ethpandaops.github.io/ethereum-helm-charts --force-update
    ensure helm repo add obol https://obolnetwork.github.io/helm-charts/ --force-update
    ensure helm repo add prometheus-community https://prometheus-community.github.io/helm-charts/

    # Update helm repos
    helm repo update

    # Deploy a Helm Release named "kubernetes-dashboard" using the kubernetes-dashboard chart
    #helm upgrade --install kubernetes-dashboard kubernetes-dashboard/kubernetes-dashboard --create-namespace --namespace kubernetes-dashboard

    log_info "Installing the Obol Stack Ethereum light client configured for $__network..."
    ensure helm upgrade  --namespace l1 --create-namespace --hide-notes --force --install l1-light-client obol/helios -f ../values/$__network/helios.yaml

    # If mode="full", also sync a full node
    if [[ "$__mode" = "full" ]]; then
        log_info "Installing an Ethereum full node client synced to $__network..."
        ensure helm upgrade --install --namespace l1 --create-namespace l1-full-node ethereum/ethereum-node -f ../values/ethereum-node.yaml  --set global.main.network=$__network
    fi

    log_info "Installing the Obol Stack Ethereum eRPC load balancer..."
    ensure helm upgrade --namespace l1 --create-namespace --force --install l1-rpc ethereum/erpc -f ../values/erpc.yaml

    # If headless mode is not present, add an ingress-controller, wait for it to be healthy, then install ingress routes.
    # Also set a local DNS override for http://obol.stack -> 127.0.0.1
    if [[ "$__headless" -eq 0 ]]; then
            log_info "Preparing host mode for the Obol Stack..."

            # Add the ingress-controller chart repository
            ensure helm repo add ingress-nginx https://kubernetes.github.io/ingress-nginx --force-update

            # Install nginx as an ingress-controller for the cluster
            log_info "Installing the Obol Stack web browser traffic load balancer..."
            ensure helm upgrade --namespace ingress --create-namespace  --hide-notes --install ingress-nginx ingress-nginx/ingress-nginx -f ../values/ingress-nginx.yaml

            # Set a local DNS name
            if grep -q "^127.0.0.1[[:space:]].*obol.stack" /etc/hosts; then
                log_info "http://obol.stack local DNS name already set..."
            else
                log_info "Setting the http://obol.stack local DNS name, you may be asked for your password..."
                echo "127.0.0.1 obol.stack" | sudo tee -a /etc/hosts > /dev/null
            fi

            # Set up ingress routes when the controller is ready
            log_info "Preparing to route http://obol.stack traffic to the stack, this may take some time..."
            local READY="false"
            while [[ "$READY" != "true" ]]; do
                sleep 10
                # Get the Ready condition status of the ingress controller pod
                READY=$(kubectl get pods -n ingress -l app.kubernetes.io/component=controller \
                    -o jsonpath='{.items[0].status.containerStatuses[0].ready}' 2>/dev/null)
                log_info "Waiting for the ingress controller to become ready..."
            done
            log_info "Obol Stack ingress controller is ready, setting up the website and exposing the RPC..."

            # Route the eRPC pod to `http://obol.stack/rpc`
            kubectl apply -f ./manifests/expose-erpc.yaml 2>/dev/null

            # Route a minimal static website to http://obol.stack/
            kubectl apply -f ./manifests/hello-world-server.yaml 2>/dev/null

            # Lazy way to let nginx become healthy before loading the landing page
            sleep 3

            # Launch home page
            log_info "Launching the Obol Stack..."
            xdg-open "https://obol.stack" 2>/dev/null || open "http://obol.stack" 2>/dev/null || log_warn "Could not open browser automatically, navigate to http://obol.stack in your browser..."
    fi

    # Install kube-prometheus-stack (Prometheus + Grafana + Alertmanager)
    log_info "Installing the Obol monitoring stack..."
    if [[ "$__headless" -eq 0 ]]; then
        ensure helm upgrade --hide-notes --namespace monitoring --create-namespace --install monitoring prometheus-community/kube-prometheus-stack -f ../values/kube-prometheus-stack.yaml
        log_info "Obol monitoring stack installed. Access the Grafana UI at: http://obol.stack/monitoring. Username: obol Password: obolstack "
    else
        # Disable the ingresses if --headless mode is supplied
        ensure helm upgrade --hide-notes --namespace monitoring --create-namespace --install monitoring prometheus-community/kube-prometheus-stack -f ../values/kube-prometheus-stack.yaml --set grafana.ingress.enabled=false --set alertmanager.ingress.enabled=false
    fi

   }

# Main logic
main() {
    # Instantiate
    local network=""
	local mode=""
    declare -i headless=0
    declare -i clean=0

	# Parse the CLI flags
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--help) help 0 ;;
		--network)
			network="$2"
			shift 2
			;;
        --mode)
			mode="$2"
			shift 2
			;;
        --headless)
			headless=1
			shift 1
			;;
        --clean)
			clean=1
			shift 1
			;;
        *)
			echo "Unknown option: $1" >&2
			help
			;;
		esac
	done

    banner

    # Parse network and sync mode
    validate_network network
	validate_sync_mode mode

    log_info "Starting obolup..."
    log_info "Detected platform: $PLATFORM"
    log_info "Detected architecture: $ARCHITECTURE"
    log_info "Selected network: $network"
    log_info "Selected node type: $mode"
    # start_docker
    start_docker
    install_kubectl
    install_kind
    install_helm
    install_k9s

    #install_obol_cli
    #check_obolup_update
    if [[ "$clean" -ne 0 ]]; then
        log_info "Clean command specified, deleting and recreating Obol Stack resources..."
        kind delete cluster --name "$STACK_NAME"
    fi

    launch_stack network mode headless

    log_info "Obol Stack is up and running!"
    exit 0
}


