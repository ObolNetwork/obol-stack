#!/usr/bin/env bash

# modified from https://github.com/foundry-rs/foundry/blob/master/foundryup/foundryup

# obolup - Obol Stack Updater and Launcher

set -Eeuo pipefail


# Constants
readonly OBOL_CLI_REPO="https://github.com/obolnetwork/obol-cli"
readonly KIND_VERSION="v0.27.0"
readonly OBOLUP_URL="https://stack.obol.org/obolup"
readonly STACK_NAME="obol-stack"
readonly STATUS_PORT=8080

# Colors for output
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m' # No Color

# Network name to chain ID mapping
declare -A -r SUPPORTED_NETWORKS=(
	["hoodi"]="560048"
    ["mainnet"]="1"
)
# Supported sync types
declare -A -r SUPPORTED_MODES=(
	["light"]=1
    ["full"]=2
)

readonly BASE_DIR=${XDG_CONFIG_HOME:-$HOME}


tolower() {
  echo "$1" | awk '{print tolower($0)}'
}

# Get platform + architecture
readonly uname_s=$(uname -s)
PLATFORM=$(tolower "${OBOLUP_PLATFORM:-$uname_s}")
ARCHITECTURE=unset
EXT="tar.gz"
case $PLATFORM in
    linux) ;;
    darwin|mac*)
    PLATFORM="darwin"
    ;;
    mingw*|win*)
    EXT="zip"
    PLATFORM="win32"
    ;;
    *)
    err "unsupported platform: $PLATFORM"
    ;;
esac

readonly uname_m=$(uname -m)
ARCHITECTURE=$(tolower "${OBOLUP_ARCH:-$uname_m}")
if [ "${ARCHITECTURE}" = "x86_64" ]; then
    # Redirect stderr to /dev/null to avoid printing errors if non Rosetta.
    if [ "$(sysctl -n sysctl.proc_translated 2>/dev/null)" = "1" ]; then
    ARCHITECTURE="arm64" # Rosetta.
    else
    ARCHITECTURE="amd64" # Intel.
    fi
elif [ "${ARCHITECTURE}" = "arm64" ] ||[ "${ARCHITECTURE}" = "aarch64" ] ; then
    ARCHITECTURE="arm64" # Arm.
else
    ARCHITECTURE="amd64" # Amd.
fi


# Run a command that should never fail. If the command fails execution
# will immediately terminate with an error showing the failing command.
ensure() {
  if ! "$@"; then err "command failed: $*"; fi
}

# Downloads $1 into $2 or stdout
download() {
  if [ -n "$2" ]; then
    # output into $2
    if check_cmd curl; then
      curl -#o "$2" -L "$1"
    else
      wget --show-progress -qO "$2" "$1"
    fi
  else
    # output to stdout
    if check_cmd curl; then
      curl -#L "$1"
    else
      wget --show-progress -qO- "$1"
    fi
  fi
}

# Validate the network
validate_network() {
	declare -n __network="$1"

	if [[ -z "$__network" ]]; then
		log_info "Network name is empty. Defaulting to mainnet"
        __network="mainnet"
	fi

	if [[ -z "${SUPPORTED_NETWORKS[$__network]:-}" ]]; then
		log_warn "Unrecognised network name: \"${__network}\".\n"
		help 1
	fi
}

# Validate the sync mode
validate_sync_mode() {
	declare -n __mode="$1"

	if [[ -z "$__mode" ]]; then
		log_info "Sync mode is empty. Defaulting to light node sync mode."
        __mode="light"
	fi

	if [[ -z "${SUPPORTED_MODES[$__mode]:-}" ]]; then
		log_warn "Unrecognised sync mode: \"${__mode}\".\n"
		help 1
	fi
}

# Log functions
log_info() { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }

# Check if a command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Ensure Docker is running
start_docker() {
    log_info "Checking Docker..."
    if ! command_exists docker; then
        log_error "Docker is not installed. Please install Docker first."
    fi
    if ! docker info >/dev/null 2>&1; then
        log_info "Starting Docker..."
        if [ "${PLATFORM}" = "linux" ]; then
            sudo systemctl start docker || log_error "Failed to start Docker."
        elif [ "${PLATFORM}" = "darwin" ]; then
            open -jga Docker
        else
            log_error "Failed to start Docker."
        fi
    fi
    log_info "Docker is running."
}

# Install or update kubectl
install_kubectl() {
    log_info "Checking kubectl..."
    # Check if kubectl is already installed
    if command_exists kubectl; then
        log_info "kubectl is already installed."
    else
        log_info "Installing kubectl..."
        # Download the latest release
        ensure curl -sSLO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/$ARCHITECTURE/kubectl"
        
        # Validate the binary (optional)
        ensure curl -sSLO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/$ARCHITECTURE/kubectl.sha256"
        echo "$(cat kubectl.sha256)  kubectl" | sha256sum --check || log_warn "kubectl checksum validation failed. Continuing anyway..."
        
        # Install kubectl
        ensure sudo install -o root -g root -m 0755 kubectl /usr/local/bin/kubectl
        
        # Clean up
        rm -f kubectl kubectl.sha256
        
        log_info "kubectl installed successfully."
    fi
}

# Install or update Helm
install_helm() {
    log_info "Checking helm..."

    # Fetch and extract the latest helm release version
    LATEST_RELEASE=$(curl -s "https://api.github.com/repos/helm/helm/releases/latest" | grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/')

    # Output the latest release
    log_info "Latest helm version available: $LATEST_RELEASE"

    # Check if kubectl is already installed
    if command_exists helm; then
        log_info "helm is already installed. Version installed: $(helm version --short)"
    else
        log_info "helm in not installed."
        log_info "Installing helm..."
        # Download the latest release
        ensure curl -sSL -O "https://get.helm.sh/helm-$LATEST_RELEASE-$PLATFORM-$ARCHITECTURE.tar.gz"

        # Validate the binary (optional)
        ensure curl -sSLo helm.tar.gz.sha256sum "https://get.helm.sh/helm-$LATEST_RELEASE-$PLATFORM-$ARCHITECTURE.tar.gz.sha256sum"
        echo "$(cat helm.tar.gz.sha256sum)" | sha256sum --check --status || log_error "helm checksum validation failed. helm installation failed."

        # Proceed to install
        ensure tar -xzf helm-$LATEST_RELEASE-$PLATFORM-$ARCHITECTURE.tar.gz
        ensure chmod +x ./$PLATFORM-$ARCHITECTURE/helm
        ensure sudo mv ./$PLATFORM-$ARCHITECTURE/helm /usr/local/bin/
        rm helm-$LATEST_RELEASE-$PLATFORM-$ARCHITECTURE.tar.gz helm.tar.gz.sha256sum
        rm -r ./$PLATFORM-$ARCHITECTURE

        log_info "helm installed successfully."
    fi

}

# Install or update Kind
install_kind() {
    log_info "Checking Kind..."
    if ! command_exists kind || [[ "$(kind version | grep -o 'v[0-9]\+\.[0-9]\+\.[0-9]\+')" != "$KIND_VERSION" ]]; then
        log_info "Installing Kind $KIND_VERSION..."
        ensure curl -sSLo ./kind "https://kind.sigs.k8s.io/dl/$KIND_VERSION/kind-$PLATFORM-$ARCHITECTURE"
        chmod +x ./kind
        sudo mv ./kind /usr/local/bin/kind
    fi
    log_info "Kind $KIND_VERSION is installed."
}

# Install or update obol CLI
install_obol_cli() {
    log_info "Checking obol CLI..."
    LATEST_OBOL_VERSION=$(ensure curl -sS "$OBOL_CLI_REPO/releases/latest" | grep -o 'v[0-9]\+\.[0-9]\+\.[0-9]\+')
    log_info "Latest Obol CLI version is $LATEST_OBOL_VERSION"
    if ! command_exists obol || [[ "$(obol --version >/dev/null 2>&1)" != *"$LATEST_OBOL_VERSION"* ]]; then
        log_info "Installing obol CLI $LATEST_OBOL_VERSION..."
        ensure curl -sSLo obol.tar.gz "$OBOL_CLI_REPO/releases/download/$LATEST_OBOL_VERSION/obol-$PLATFORM-$ARCHITECTURE.tar.gz"
        tar -xzf obol.tar.gz
        chmod +x obol
        sudo mv obol /usr/local/bin/
        rm obol.tar.gz
    fi
    log_info "Obol CLI $LATEST_OBOL_VERSION is installed."
}

# Check for obolup updates (warn only, don’t update)
check_obolup_update() {
    log_info "Checking for obolup updates..."
    REMOTE_HASH=$(curl -s "$OBOLUP_URL" | sha256sum | awk '{print $1}')
    LOCAL_HASH=$(sha256sum "$0" | awk '{print $1}')
    if [[ "$REMOTE_HASH" != "$LOCAL_HASH" ]]; then
        log_warn "A newer version of obolup is available. Run: sh <(curl https://stack.obol.org/sh)"
    else
        log_info "obolup is up to date."
    fi
}

# Launch or update the Obol Stack
launch_stack() {
    log_info "Launching core Obol Stack services..."
    if ! kind get clusters | grep -q "$STACK_NAME"; then
        log_info "Creating Kind cluster for Obol Stack..."
        kind create cluster --name "$STACK_NAME" --config <(cat <<EOF
kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
nodes:
- role: control-plane
EOF
        )
    fi

    # Apply base Obol Stack resources (e.g., namespaces, monitoring)
    #log_info "Applying Obol Stack base resources..."
    #kubectl apply -f https://stack.obol.org/base.yaml || log_error "Failed to apply base resources."

    # Add the appropriate Helm repos (ethpandaops, Obol, kubernetes-dashboard)
    log_info "Adding default Obol Stack app stores..."
    ensure helm repo add ethereum https://ethpandaops.github.io/ethereum-helm-charts
    ensure helm repo add obol https://obolnetwork.github.io/helm-charts/
    #ensure helm repo add kubernetes-dashboard https://kubernetes.github.io/dashboard/

    # Update helm repos
    helm repo update

    # Deploy a Helm Release named "kubernetes-dashboard" using the kubernetes-dashboard chart
