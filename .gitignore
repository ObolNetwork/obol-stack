# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
package-lock.json

# testing
/coverage

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/e2e/**/*.png
/e2e/**/*.jpeg
/e2e/**/*.jpg
/e2e/**/.auth
!/e2e/**/*.spec.ts-snapshots/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# obol
charon-enr-private-key
**/validator_keys/*

# local state / legacy tooling (never commit)
/.data/
/.worktrees/
yarn.lock
.eslintrc*
