# Build context for pure-Go images (Dockerfile.x402*) and storefront.
# Keep this tight — every byte is uploaded to BuildKit on each CI run.

.workspace*
.build/
.tmp/
.git/
.gitignore
.worktrees/
.claude/
.agents/
.github/
bin/
docs/
flows/
tests/
plansold/
plans/
node_modules/
# Nested too: a host web/public-storefront/node_modules (e.g. darwin builds
# from a local `npm install`) would otherwise be copied over the image's
# `npm ci` output, mixing package versions (next vs @next/swc).
**/node_modules/
**/.next/
coverage/
*.log
*.out
*.tmp

# Frontend monorepo bulk (~400MB). Keep only the public storefront.
web/**
!web/public-storefront/
!web/public-storefront/**

# Tests and fixtures are not compiled into release binaries.
**/*_test.go
**/testdata/
**/*_test/
**/testdata/**
**/.gitkeep

# Local env / IDE noise
.env*
!.env.example
.idea/
.vscode/
*.swp
.DS_Store
