# Build context for pure-Go images (Dockerfile.x402*) and storefront.
# Keep this tight — every byte is uploaded to BuildKit on each CI run.

.workspace*
.build/
.tmp/
.git/
.gitignore
.worktrees/
.claude/
.agents/
.github/
bin/
docs/
flows/
tests/
plansold/
plans/
node_modules/
coverage/
*.log
*.out
*.tmp

# Frontend monorepo bulk (~400MB). Keep only the public storefront.
web/**
!web/public-storefront/
!web/public-storefront/**
# After the re-include above (last match wins): a host
# web/public-storefront/node_modules from a local `npm install` would
# otherwise be copied over the image's `npm ci` output (next vs @next/swc).
web/public-storefront/node_modules/
web/public-storefront/.next/

# Tests and fixtures are not compiled into release binaries.
**/*_test.go
**/testdata/
**/*_test/
**/testdata/**
**/.gitkeep

# Local env / IDE noise
.env*
!.env.example
.idea/
.vscode/
*.swp
.DS_Store
